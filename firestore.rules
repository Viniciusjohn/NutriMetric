rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Campos que o CLIENTE pode gravar diretamente: dados de conta
      // (ensureUserDocument) + perfil/metas do onboarding (UserCloudRepository).
      // Tudo o mais — isPremium, isTestPremium, quota, fcmToken, lastActivityAt,
      // subscription* — é escrito só pelas Cloud Functions/webhook via Admin SDK
      // (que ignora estas regras). Whitelist em vez de blacklist: impede o
      // cliente de se auto-promover a premium E de poluir o doc com campos
      // arbitrários (abuso de custo/armazenamento).
      function clientWritableKeys() {
        return [
          'displayName', 'email', 'updatedAt',
          'heightCm', 'age', 'sex', 'activityLevel', 'goal', 'onboardingCompleted',
          'weightKg', 'goalCalories', 'goalProtein', 'goalCarbs', 'goalFat',
          'goalWaterMl', 'profileUpdatedAt'
        ];
      }

      // O usuário só enxerga o próprio documento.
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(clientWritableKeys());
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(clientWritableKeys());
      allow delete: if false;

      // Quota diária: leitura permitida (para exibir "fotos restantes" na UI),
      // escrita proibida — só as Cloud Functions incrementam.
      match /usage/{date} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Qualquer outra coleção: negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
